{
	admin off
	auto_https off
	servers {
		trusted_proxies static 100.64.0.0/10 fd00::/8 152.233.0.0/17
	}
}

:{$PORT:8080} {
	# Railway's health-check prober is anonymous, so this exact path is matched
	# before the authenticated catch-all below. Caddy evaluates `handle` blocks
	# in the order written, not by matcher specificity.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		basic_auth {
			{$DASHBOARD_USERNAME} {$DASHBOARD_PASSWORD_HASH}
		}
		reverse_proxy {$DASHBOARD_UPSTREAM:meta.railway.internal:5691}
	}
}
